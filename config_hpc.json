{
    "data_directories": {
      "dataset_root": "/projects/kg98/trangc/VBM/data_exemplar",
      "data": "./data",
      "data_BIDS": "./data_BIDS",
      "VBM": "./VBM",
      "SBM": "./SBM",
      "utils": "./utils",
        "conda_env": "/scratch/kg98/trangc/miniconda/bin/activate"
    },
    
    "datasets": {
      "Myelin": {
        "path": "${dataset_root}/Myelin",
        "bids_script": "BIDS_Myelin.m",
        "vbm_extract_script": "extract_sub_Myelin.m",
        "enabled": true,
        "longitudinal": true,
        "combat_group": "psy"
      },
      "RD": {
        "path": "${dataset_root}/RD",
        "bids_script": "BIDS_RD.m",
        "vbm_extract_script": "extract_sub_RD.m",
        "enabled": true,
        "longitudinal": false,
        "combat_group": "psy"
      }

    },
    
    "pipeline_stages": {
      "organize_bids": { "enabled": true, "description": "Convert datasets to BIDS format" },
      "step1a_VBM_CAT12_preprocess": { "enabled": true, "description": "VBM CAT12 preprocessing" },
      "step1b_VBM_CAT12_report_concat": { "enabled": true, "description": "VBM CAT12 QC report concatenation" },
      "step1c_VBM_CAT12_visualisation": { "enabled": true, "description": "VBM CAT12 visualization" },
      "step2_VBM_extract_subjects": { "enabled": true, "description": "VBM extract subjects for analysis" },
      "step3_VBM_smoothing": { "enabled": true, "description": "VBM smoothing" },
      "step4a_VBM_combat_input": { "enabled": true, "description": "VBM prepare input for COMBAT harmonization" },
      "step4b_VBM_combat": { "enabled": true, "description": "VBM COMBAT harmonization" },
      "step4c_VBM_combat_output": { "enabled": true, "description": "VBM output COMBAT harmonization" },
      "step5_VBM_metadata": { "enabled": true, "description": "VBM combine metadata" },
      "step6_VBM_statistical_analysis": { "enabled": true, "description": "VBM statistical analysis" },
      "VBM_statistical_analysis": { "enabled": true, "description": "VBM statistical analysis" },
      "VBM_parcellation": { "enabled": true, "description": "VBM parcellation" },
      "VBM_nulltest": { "enabled": true, "description": "VBM null testing" },
      "VBM_consistency": { "enabled": true, "description": "VBM consistency analysis" },
      "VBM_covariates": { "enabled": true, "description": "VBM covariate analysis" },
      "VBM_figures": { "enabled": true, "description": "VBM figure generation" },
      "SBM_recon_all": { "enabled": true, "description": "SBM recon-all" },
      "SBM_autoQC": { "enabled": true, "description": "SBM auto QC" },
      "SBM_surfacevis": { "enabled": true, "description": "SBM surface visualization" },
      "SBM_extract_subjects": { "enabled": true, "description": "SBM extract subjects" },
      "SBM_combat": { "enabled": true, "description": "SBM COMBAT harmonization" },
      "SBM_metadata": { "enabled": true, "description": "SBM combine metadata" },
      "SBM_statistical_analysis": { "enabled": true, "description": "SBM statistical analysis" },
      "SBM_parcellation": { "enabled": true, "description": "SBM parcellation" },
      "SBM_nulltest": { "enabled": true, "description": "SBM null testing" },
      "SBM_consistency": { "enabled": true, "description": "SBM consistency analysis" },
      "SBM_covariates": { "enabled": true, "description": "SBM covariate analysis" },
      "SBM_sample_size_effect": { "enabled": true, "description": "SBM sample size effect" },
      "SBM_figures": { "enabled": true, "description": "SBM figure generation" }
    },
    
    "output_directories": {
      "results": "${dataset_root}/results",
      "figures": "${dataset_root}/figures",
      "temp": ".\\temp"
    },
    
    "execution_mode": {
      "type": "local",
      "hpc_enabled": true,
      "slurm_settings": {
        "partition": "default",
        "time": "24:00:00",
        "mem": "8G",
        "cpus_per_task": 4,
        "account": "",
        "mail_type": "END",
        "mail_user": ""
      },
      "local_settings": {
        "max_parallel_jobs": 4,
        "use_gnu_parallel": false
      }
    },
    
    "analysis_settings": {
      "age_range": {
        "min": 18,
        "max": 60
      },
      "minimum_subjects_per_site": 20,
      "masking_threshold": 0.2,
      "cat12_quality_threshold": 2.8,
      "smoothing_kernel": 6,
      "harmonize": 1,
      "mask_diagnostic_group": "psy",
      "num_permutations": 10
    },
    
    "software_paths": {
      "matlab": "usr/local/bin/matlab",
      "freesurfer": "",
      "cat12": ""
    }
  }