{
    "data_directories": {
      "dataset_root": "/projects/kg98/trangc/VBM/data_exemplar",
      "data": "./data",
      "data_BIDS": "./data_BIDS",
      "VBM": "./VBM",
      "SBM": "./SBM",
      "utils": "./utils",
      "atlas_dir": "/projects/kg98/trangc/atlases/Human_standard_surface",
        "conda_env": "/scratch/kg98/trangc/miniconda/bin/activate"
    },
    
    "datasets": {
      "Myelin": {
        "path": "${dataset_root}/Myelin",
        "bids_script": "BIDS_Myelin.m",
        "vbm_extract_script": "extract_sub_Myelin.m",
         "sbm_extract_surface_script": "extract_sub_surface_Myelin.m",
        "enabled": true,
        "longitudinal": true,
        "combat_group": "psy"
      },
      "RD": {
        "path": "${dataset_root}/RD",
        "bids_script": "BIDS_RD.m",
        "vbm_extract_script": "extract_sub_RD.m",
        "sbm_extract_surface_script": "extract_sub_surface_RD.m",
        "enabled": true,
        "longitudinal": false,
        "combat_group": "psy"
      }

    },
        
    "output_directories": {
      "results": "${dataset_root}/results",
      "figures": "${dataset_root}/figures",
      "temp": ".\\temp"
    },
    
    "execution_mode": {
      "type": "local",
      "hpc_enabled": true,
      "slurm_settings": {
        "partition": "default",
        "time": "24:00:00",
        "mem": "8G",
        "cpus_per_task": 4,
        "account": "",
        "mail_type": "END",
        "mail_user": ""
      },
      "local_settings": {
        "max_parallel_jobs": 4,
        "use_gnu_parallel": false
      }
    },
    
    "analysis_settings": {
      "age_range": {
        "min": 18,
        "max": 60
      },
      "minimum_subjects_per_site": 20,
      "masking_threshold": 0.2,
      "cat12_quality_threshold": 2.8,
      "vbm_smoothing_kernel": 6,
      "sbm_smoothing_kernel": 10,
      "harmonize": 1,
      "mask_diagnostic_group": "psy",
      "num_permutations": 10
    },
    
    "software_paths": {
      "matlab": "usr/local/bin/matlab",
      "freesurfer": "",
      "cat12": ""
    }
  }