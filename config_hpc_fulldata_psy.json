    "output_directories": {
      "results": "${dataset_root}/results",
      "figures": "${dataset_root}/figures",
      "temp": ".\\temp"
    },
    
    "execution_mode": {
      "type": "local",
      "hpc_enabled": true,
      "slurm_settings": {
        "partition": "default",
        "time": "24:00:00",
        "mem": "8G",
        "cpus_per_task": 4,
        "account": "",
        "mail_type": "END",
        "mail_user": ""
      },
      "local_settings": {
        "max_parallel_jobs": 4,
        "use_gnu_parallel": false
      }
    },
    
    "analysis_settings": {
      "age_range": {
        "min": 18,
        "max": 60
      },
      "minimum_subjects_per_site": 20,
      "masking_threshold": 0.2,
      "cat12_quality_threshold": 2.8,
      "smoothing_kernel": 6,
      "harmonize": 1,
      "mask_diagnostic_group": "psy",
      "num_permutations": 100
    },
    
    "software_paths": {
      "matlab": "usr/local/bin/matlab",
      "freesurfer": "",
      "cat12": ""
